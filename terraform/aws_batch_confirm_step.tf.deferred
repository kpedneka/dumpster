# DEFERRED -- not active. Renamed off the .tf extension on purpose so
# Terraform/OpenTofu ignores this file entirely; nothing here runs until
# it's renamed back. Content is otherwise unchanged from when it was
# written and validated (validate passed under Terraform at the time;
# `plan` was not completed -- see the "Terraform for confirm-step Batch
# job infrastructure" dev board card). Parked here deliberately: this is
# being folded into the ECS migration's infrastructure-as-code work
# instead of applied standalone now, alongside a staging-environment
# design (spin up, test, tear down, then deploy) that should shape how
# this and the ECS resources get structured together. Rename back to
# aws_batch_confirm_step.tf and re-run `tofu init`/`plan` when that work
# starts.
#
# Tooling note: this project switched from Terraform to OpenTofu after
# this file was written and validated (see the "Terraform for ECS
# services" dev board card for the full reasoning -- BSL doesn't
# restrict our actual use, but switching now while little infrastructure
# code exists costs nothing). No content here needed to change for that
# switch -- OpenTofu reads the same HCL, same .tf files, same provider
# ecosystem. Re-validate with `tofu validate` when this is reactivated,
# not `terraform validate`.
#
# AWS resources for the confirm-step models (cross-chunk linking + alias
# merging), the third automatic ingestion step being folded in alongside
# entity extraction and canonicalization -- see the "Fold cross-chunk
# linking + alias merging into automatic ingestion" card on the Knowledge
# Graph Recall Gap dev board for the feature work this supports.
#
# Scope, deliberately narrow: this file provisions ONLY the new resources
# this job needs -- an ECR repository and an AWS Batch job definition. It
# does not define, modify, or import dumpster-batch-gpu-pilot itself (the
# GPU compute environment and job queue entity extraction already runs
# on) -- that resource predates this file, was provisioned by hand, and is
# NOT under Terraform management. This job definition submits into that
# existing queue via a variable, the same way internal/entity/awsbatch's
# job definition already does at the application layer. Bringing the two
# already-existing Batch job types (entity extraction, embedding) under
# Terraform too is tracked as a separate, deliberately deferred card --
# not done here, so this change stays small and reviewable.
#
# No new execution-role IAM is defined here on purpose: this is an EC2
# (not Fargate) Batch job, so ECR pull + CloudWatch Logs permissions come
# from the compute environment's existing EC2 instance profile, the same
# one entity extraction's job already runs under successfully -- adding a
# second, redundant role here would be guessing at IAM this file has no
# visibility into, not a real requirement. job_role_arn below is exposed
# as optional, unset by default, for if the container ever needs to call
# an AWS API directly -- it doesn't today (see scripts/batch_entity_job.py's
# own docstring for why this codebase deliberately keeps Batch containers
# off real AWS credentials, presigned URLs only).
#
# The image this job definition references does not exist yet -- building
# and pushing it (a Dockerfile sharing a base layer with the entity-
# extraction image, per the confirm-step hosting design) is separate,
# not-yet-started implementation work. This provisions the namespace the
# image will be pushed to, not the artifact itself.
#
# Apply only after review, against the production AWS account:
#   cd terraform
#   tofu init
#   tofu plan  -var="job_queue_arn=<existing dumpster-batch-gpu-pilot queue ARN>"
#   tofu apply -var="job_queue_arn=<existing dumpster-batch-gpu-pilot queue ARN>"
#
# Requires the AWS provider ~> 5.0 (OpenTofu uses the same
# registry/provider ecosystem as Terraform):
#   https://registry.terraform.io/providers/hashicorp/aws/latest/docs

variable "aws_region" {
  type        = string
  description = "AWS region dumpster-batch-gpu-pilot runs in"
  default     = "us-east-1"
}

variable "job_queue_arn" {
  type        = string
  description = "ARN of the existing dumpster-batch-gpu-pilot AWS Batch job queue (entity extraction's queue) this job definition submits into. Not managed by this file -- look it up from the AWS Batch console or the running worker's BATCH_JOB_QUEUE config."
}

variable "image_tag" {
  type        = string
  description = "Tag of the confirm-step image to reference. The repository is created here; the image itself is pushed by a separate build/deploy step, not by this file."
  default     = "latest"
}

variable "vcpus" {
  type        = number
  description = "vCPUs requested per job. Defaults to g4dn.xlarge's full 4 vCPUs -- one job per instance at a time on a single-GPU instance type, so there's no reason to under-claim."
  default     = 4
}

variable "memory_mib" {
  type        = number
  description = "Memory (MiB) requested per job. g4dn.xlarge has 16 GiB total; this leaves headroom below that for the OS and the Batch/ECS agent rather than claiming the full 16000+ MiB. Revisit once gliner_mediumv2.1's and the confirm-step model's actual combined footprint is measured -- see the hosting design's benchmarking step, still open."
  default     = 15000
}

variable "gpu_count" {
  type        = number
  description = "GPUs requested per job. g4dn.xlarge has exactly one T4."
  default     = 1
}

variable "job_role_arn" {
  type        = string
  description = "Optional IAM role for the running container to assume, if it ever needs to call an AWS API directly. Unset by default -- this job only ever talks to presigned URLs, not real AWS credentials, matching the existing entity-extraction job's security posture."
  default     = null
}

resource "aws_ecr_repository" "confirm_step" {
  name                 = "dumpster-confirm-step"
  image_tag_mutability = "IMMUTABLE"

  image_scanning_configuration {
    scan_on_push = true
  }
}

resource "aws_batch_job_definition" "confirm_step" {
  name                  = "dumpster-confirm-step"
  type                  = "container"
  platform_capabilities = ["EC2"]

  container_properties = jsonencode({
    image = "${aws_ecr_repository.confirm_step.repository_url}:${var.image_tag}"

    resourceRequirements = concat(
      [
        { type = "VCPU", value = tostring(var.vcpus) },
        { type = "MEMORY", value = tostring(var.memory_mib) },
      ],
      var.gpu_count > 0 ? [{ type = "GPU", value = tostring(var.gpu_count) }] : []
    )

    jobRoleArn = var.job_role_arn

    logConfiguration = {
      logDriver = "awslogs"
      options = {
        "awslogs-group"         = "/aws/batch/dumpster-confirm-step"
        "awslogs-region"        = var.aws_region
        "awslogs-stream-prefix" = "confirm-step"
      }
    }
  })

  retry_strategy {
    attempts = 1 # matches entity extraction: a Batch failure here is deterministic, not transient -- retrying just wastes compute
  }
}

output "ecr_repository_url" {
  value       = aws_ecr_repository.confirm_step.repository_url
  description = "Push the confirm-step image here, tagged to match var.image_tag."
}

output "job_definition_arn" {
  value       = aws_batch_job_definition.confirm_step.arn
  description = "Set as CONFIRMSTEP_BATCH_JOB_DEFINITION in the worker's environment, alongside CONFIRMSTEP_BATCH_JOB_QUEUE = var.job_queue_arn -- same naming pattern as the existing BATCH_JOB_QUEUE/BATCH_JOB_DEFINITION and EMBED_BATCH_JOB_QUEUE/EMBED_BATCH_JOB_DEFINITION pairs in internal/config/config.go."
}
