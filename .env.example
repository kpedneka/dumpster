# ── Server ──────────────────────────────────────────────────────────────────
HTTP_PORT=8080
METRICS_PORT=9090
# Set to false only for local dev without TLS (e.g. running the API with
# `go run` / `make run` behind the plain-http Vite dev proxy). A Secure
# cookie sent over http is silently dropped by the browser, which mints a
# new session on every request. Must stay true (the default) anywhere the
# API is reached over TLS, including staging and production.
COOKIE_SECURE=true

# ── Session sweep (worker) ────────────────────────────────────────────────────
# How often the always-on worker runs the session lifecycle sweep.
# Lower this in staging to verify cleanup quickly (e.g. SWEEP_INTERVAL=1m).
SWEEP_INTERVAL=5m

# ── Worker concurrency ────────────────────────────────────────────────────────
# How many jobs the worker processes at once. Safe above 1 now that entity
# extraction and region classification call the inference service over HTTP
# instead of embedding a warm Python subprocess in this process.
WORKER_CONCURRENCY=5

# ── Database (Neon) ──────────────────────────────────────────────────────────
# DATABASE_URL      — direct (non-pooled) endpoint; used by the worker and migrations.
# DATABASE_URL_POOLED — PgBouncer (-pooler) endpoint; used by the API.
# Both can be found in the Neon dashboard under "Connection Details".
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
DATABASE_URL_POOLED=postgresql://<user>:<password>@<host>-pooler.neon.tech/<dbname>?sslmode=require

# ── Object storage (Cloudflare R2) ────────────────────────────────────────────
# Create a separate bucket for each environment (e.g. dumpster-dev, dumpster-prod).
# Generate an R2 API token in the Cloudflare dashboard with Object Read & Write.
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=dumpster-dev
S3_ACCESS_KEY=<r2-access-key-id>
S3_SECRET_KEY=<r2-secret-access-key>
S3_USE_PATH_STYLE=false
# Scratch bucket for temporary files generated by AWS Batch activity
R2_SCRATCH_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_SCRATCH_REGION=auto
R2_SCRATCH_BUCKET=dumpster-dev-scratch
R2_SCRATCH_ACCESS_KEY=<r2-access-key-id>
R2_SCRATCH_SECRET_KEY=<r2-secret-access-key>
R2_SCRATCH_USE_PATH_STYLE=false


# ── LLM ──────────────────────────────────────────────────────────────────────
# Embeddings are generated locally by the inference service (see below), not
# an external API — no embedding-provider key is needed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Entity extraction (local spaCy + GLiNER) ──────────────────────────────────
# Comma-separated, closed-but-broad, domain-agnostic entity type set. Add or
# remove a type here — no code change or migration required.
ENTITY_TYPES=person,organization,location,concept,event,work_of_art,date_time

# ── Inference service ─────────────────────────────────────────────────────────
# Base URL of the consolidated ML inference service: entity extraction, PDF
# region classification, and local embeddings behind one HTTP API. Defaults
# to the docker-compose service name; override for local dev without Docker.
INFERENCE_SERVICE_URL=http://inference:8000

# ── Entity extraction backend (worker) ────────────────────────────────────────
# "inference" (default) calls INFERENCE_SERVICE_URL above. "awsbatch" submits
# a GPU job to AWS Batch instead (internal/entity/awsbatch) — leave unset
# unless you're testing or running that path.
# ENTITY_EXTRACTOR_BACKEND=awsbatch
#
# Required only when ENTITY_EXTRACTOR_BACKEND=awsbatch. AWS credentials come
# from the standard SDK chain (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env
# vars below), not a dedicated config field.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=<scoped-batch-user-access-key-id>
# AWS_SECRET_ACCESS_KEY=<scoped-batch-user-secret-key>
# BATCH_JOB_QUEUE=dumpster-batch-gpu-pilot-queue
# BATCH_JOB_DEFINITION=dumpster-entity-extraction

# ── Ingestion-time embedding (worker, reembed) ────────────────────────────────
# Always AWS Batch (internal/llm/awsbatch) — not optional, no HTTP fallback.
# Moved off INFERENCE_SERVICE_URL after measuring Fly's shared-cpu tier
# throttling a 47.5s embedding call into 13-16+ minutes in production; see
# internal/llm/awsbatch's package doc for the full story. Query-time
# embedding (api) is unaffected and still uses INFERENCE_SERVICE_URL above —
# a per-request Batch cold start would be unacceptable for a live search.
# Uses the same AWS credentials as entity extraction above, against a
# separate, CPU-only Fargate compute environment.
# EMBED_BATCH_JOB_QUEUE=dumpster-embedding-queue
# EMBED_BATCH_JOB_DEFINITION=dumpster-embedding-jobdef

# Optional — shared by both AWS Batch paths above. Default to
# internal/entity/awsbatch's and internal/llm/awsbatch's own defaults
# (5s / 15m) when unset.
# BATCH_POLL_INTERVAL=5s
# BATCH_PRESIGN_TTL=15m
