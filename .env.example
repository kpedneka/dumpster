# ── Server ──────────────────────────────────────────────────────────────────
HTTP_PORT=8080
METRICS_PORT=9090

# ── Database ─────────────────────────────────────────────────────────────────
# Option A: full connection strings (recommended for Neon)
#   Use the direct (non-pooled) endpoint for the worker and migrations.
#   Use the PgBouncer (-pooler) endpoint for the API.
DATABASE_URL=postgresql://dumpster:dumpster@localhost:5432/dumpster?sslmode=disable
DATABASE_URL_POOLED=postgresql://dumpster:dumpster@localhost:5432/dumpster?sslmode=disable

# Option B: individual fields (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dumpster
DB_USER=dumpster
DB_PASSWORD=dumpster
DB_SSLMODE=disable

# ── Object storage ────────────────────────────────────────────────────────────
# MinIO for local dev; Cloudflare R2 in production.
# R2 endpoint format: https://<account-id>.r2.cloudflarestorage.com
# R2 presigned URLs require the S3-API domain, not a custom domain.
# Browser-direct uploads also need CORS enabled on the R2 bucket.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=dumpster
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true   # true for MinIO; false for R2

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=24

# ── LLM / Embeddings ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
