# ── Server ──────────────────────────────────────────────────────────────────
HTTP_PORT=8080
METRICS_PORT=9090

# ── Database (Neon) ──────────────────────────────────────────────────────────
# DATABASE_URL      — direct (non-pooled) endpoint; used by the worker and migrations.
# DATABASE_URL_POOLED — PgBouncer (-pooler) endpoint; used by the API.
# Both can be found in the Neon dashboard under "Connection Details".
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
DATABASE_URL_POOLED=postgresql://<user>:<password>@<host>-pooler.neon.tech/<dbname>?sslmode=require

# ── Object storage (Cloudflare R2) ────────────────────────────────────────────
# Create a separate bucket for each environment (e.g. dumpster-dev, dumpster-prod).
# Generate an R2 API token in the Cloudflare dashboard with Object Read & Write.
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=dumpster-dev
S3_ACCESS_KEY=<r2-access-key-id>
S3_SECRET_KEY=<r2-secret-access-key>
S3_USE_PATH_STYLE=false

# ── Clerk (Authentication) ─────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_clerk_secret_key_here

# ── Vision / VLM (Ollama) ────────────────────────────────────────────────────
# Run 'make ollama-pull' once after 'make run' to download the model.
OLLAMA_URL=http://ollama:11434
OLLAMA_VLM_MODEL=qwen2.5vl

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Used for the demo account lifecycle: welcome/demo-disclosure email on
# signup and the day-6 TTL warning email.
RESEND_API_KEY=
RESEND_FROM_ADDR=noreply@example.com

# ── LLM / Embeddings ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Entity extraction (local spaCy + GLiNER) ──────────────────────────────────
# Comma-separated, closed-but-broad, domain-agnostic entity type set. Add or
# remove a type here — no code change or migration required.
ENTITY_TYPES=person,organization,location,concept,event,work_of_art,date_time
# Python interpreter and script used by the worker's local extraction adapter
# (internal/entity/gliner). See scripts/requirements.txt for the script's deps.
ENTITY_EXTRACTOR_PYTHON=python3
ENTITY_EXTRACTOR_SCRIPT=scripts/extract_entities.py
