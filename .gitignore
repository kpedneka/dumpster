# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.env.local

# Frontend
web/node_modules/
web/dist/
.DS_Store

# Python virtual environment
scripts/.venv/
__pycache__/
*.pyc

# Local scratch files for manual testing (sample documents, etc.) — not
# meant to be checked in.
examples/

# Compiled binaries from `go build ./cmd/...` run without -o — these have
# no file extension on macOS/Linux, so *.exe/*.dll above don't catch them.
/worker
/api
/reembed
/canonicalize
/cleanup

# Lambda deploy artifacts (terraform/lambda_stateless_jobs.tf's
# archive_file source) -- built by the CI/deploy pipeline immediately
# before `tofu apply`, never meant to be checked in.
/build/

# Terraform local state and provider cache -- machine-specific, never
# checked in. terraform/.terraform.lock.hcl (the provider version lock
# file) is NOT ignored -- that one is meant to be committed. Matches
# terraform/bootstrap/.terraform/ too (its own separate root module, see
# that directory's github_oidc.tf), not just terraform/.terraform/ itself.
terraform/.terraform/
terraform/bootstrap/.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Saved `tofu plan -out=...` files from local-first IaC verification
# (CLAUDE.md's IaC verification policy) -- one-off snapshots from a single
# machine at a single moment, not meant to be reviewed via git diff (binary)
# or relied on later (a plan goes stale the moment anything else changes the
# real state). Can also embed real planned resource values.
.local-plans/
*.tfplan