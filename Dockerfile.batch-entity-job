# syntax=docker/dockerfile:1
#
# AWS Batch job image for GPU entity extraction (see scripts/batch_entity_job.py
# for the actual job logic and why this exists as a Batch job rather than a
# long-running service — the earlier hand-rolled EC2 wake/sleep design was
# dropped once it turned out fast wake latency didn't actually matter for
# the UX this pipeline stage is on).
#
# Separate from the root Dockerfile: this needs the GPU-enabled PyTorch
# build (bundled CUDA runtime), the opposite of the root Dockerfile's
# `inference` stage, which deliberately pins the CPU-only wheel since Fly's
# shared-cpu machines have no GPU at all. Pushed to ECR, not deployed to
# Fly — a genuinely different artifact for a genuinely different runtime.
FROM python:3.11-slim

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The base image's own pip/setuptools/wheel lag behind their security fixes
# (setuptools vendors its own copies of wheel and jaraco.context), and
# nothing pins them, so bring them current before installing anything else.
RUN --mount=type=cache,target=/root/.cache/pip pip install --no-cache-dir --upgrade pip setuptools wheel

# GPU-enabled torch: the default PyPI index (not python.org/whl/cpu, as the
# root Dockerfile's inference stage uses) bundles the CUDA runtime this job
# actually needs to run on a GPU Batch compute environment.
#
# The uninstall in this same RUN (not a separate one -- a later layer
# deleting files never shrinks the image; overlayfs still ships the deleted
# bytes in the lower layer) drops CUDA dependencies torch declares but this
# job never exercises, measured directly against the image this replaces
# (5.9GB site-packages/):
#   nvidia-nvshmem (78MB)     -- multi-node shared memory; single-node only here
#   nvidia-cusparselt (224MB) -- structured-sparsity kernels; extract_entities.py
#                                never constructs a sparse tensor
#   triton (897MB)            -- torch.compile's JIT kernel compiler; grepped
#                                the codebase, nothing here calls torch.compile
#                                or touches torch._dynamo
# nvidia-nccl (242MB) looks like the same kind of dead weight -- this job
# never touches torch.distributed -- but plain `import torch` unconditionally
# dlopen()s libnccl.so.2 even with no distributed call in sight, confirmed by
# actually trying to remove it: it breaks the import outright. Keep it.
#
# Pinned to the versions in the last image known to work. Left unpinned,
# a fresh install (2026-10) resolved a combination under which GLiNER's
# tokenizer no longer loads (transformers asks for tiktoken), failing the
# model download below.
RUN --mount=type=cache,target=/root/.cache/pip pip install --no-cache-dir \
    "spacy==3.8.16" "gliner==0.2.28" "torch==2.14.0" "transformers==5.13.1" \
    "tokenizers==0.22.2" "huggingface_hub==1.30.0" "urllib3>=2.8" && \
    pip uninstall -y triton
RUN --mount=type=cache,target=/root/.cache/pip python -m spacy download en_core_web_sm

# Baking the GLiNER weights in and forcing offline mode avoids a live
# HuggingFace Hub round trip on every single job invocation -- unlike the
# always-on inference service (which pays this cost once, at process
# startup, and stays warm), every Batch job is a fresh container, so this
# cost would otherwise be paid on every document instead of once per image
# build.
RUN python -c "from gliner import GLiNER; GLiNER.from_pretrained('urchade/gliner_mediumv2.1')"
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

COPY scripts/extract_entities.py scripts/batch_entity_job.py /app/

# Nothing runs pip once the image is built, and pip ships its own bundled
# copies of urllib3, msgpack and setuptools that image scanners flag, so
# remove it from the final image.
RUN python -m pip uninstall -y pip
CMD ["python", "batch_entity_job.py"]
